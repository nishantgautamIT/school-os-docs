{
  "openapi": "3.0.3",
  "info": {
    "title": "campus-core-api",
    "version": "0.1.0",
    "description": "Implemented HTTP surface: health only. School provisioning, academic setup/lifecycle, students/imports, guardian/staff relationships, attendance and lessons/homework are restricted operator CLI workflows. Homework submission evidence, versioned teacher reviews and absence catch-up packs are also operator commands; they add no HTTP endpoints. Identity integration (F02) remains deferred. HEAD mirrors GET. Optional private mTLS listener exposes one identity-authorized school-profile read. The public listener still serves health only; domain operator commands are not HTTP routes."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:3000",
      "description": "Default local listener; configurable. Not a deployed production URL."
    }
  ],
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "live",
        "summary": "Liveness",
        "tags": [
          "Health"
        ],
        "description": "Unauthenticated local service health check.",
        "responses": {
          "200": {
            "description": "Healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    }
                  },
                  "required": [
                    "status"
                  ]
                }
              }
            }
          }
        },
        "security": []
      },
      "head": {
        "operationId": "liveHead",
        "summary": "Liveness (headers only)",
        "tags": [
          "Health"
        ],
        "description": "Unauthenticated local service health check. HEAD uses GET handling and returns no body.",
        "responses": {
          "200": {
            "description": "Healthy"
          }
        },
        "security": []
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "ready",
        "summary": "Database/schema readiness",
        "tags": [
          "Health"
        ],
        "description": "Unauthenticated local service health check.",
        "responses": {
          "200": {
            "description": "Healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    },
                    "database": {
                      "type": "string",
                      "enum": [
                        "available"
                      ]
                    }
                  },
                  "required": [
                    "status",
                    "database"
                  ]
                }
              }
            }
          },
          "503": {
            "description": "Unavailable or busy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "statusCode": {
                      "type": "integer"
                    },
                    "message": {
                      "type": "string"
                    },
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "statusCode",
                    "message"
                  ]
                }
              }
            }
          }
        },
        "security": []
      },
      "head": {
        "operationId": "readyHead",
        "summary": "Database/schema readiness (headers only)",
        "tags": [
          "Health"
        ],
        "description": "Unauthenticated local service health check. HEAD uses GET handling and returns no body.",
        "responses": {
          "200": {
            "description": "Healthy"
          },
          "503": {
            "description": "Unavailable or busy"
          }
        },
        "security": []
      }
    },
    "/v1/schools/{tenantId}": {
      "get": {
        "operationId": "getAuthenticatedSchoolProfile",
        "summary": "Read the selected active school profile",
        "description": "Private TLS 1.3 listener only; caller certificate must contain exact URI SAN spiffe://campus/campus-api-gateway. Forward exactly one __Host-campus_session cookie. Online identity requires matching selected tenant and school.read; core then checks active/linked school and applies transaction-local tenant RLS. No names of individuals or learning content. Successful access audit commits before response. Every request is rechecked; no cached authorization or fallback. Already admitted work may finish after identity revocation. No teacher/guardian relationship access or mutation is granted. No HEAD alias. The common gateway routes this read.",
        "tags": [
          "Schools"
        ],
        "servers": [
          {
            "url": "https://127.0.0.1:3442",
            "description": "Optional private mTLS listener; not publicly routed."
          }
        ],
        "security": [
          {
            "CampusSession": []
          }
        ],
        "x-mtls-required": true,
        "x-client-uri-san": "spiffe://campus/campus-api-gateway",
        "parameters": [
          {
            "name": "tenantId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "No-store school profile; audited access.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "code",
                    "name",
                    "status",
                    "timezone"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "code": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "active"
                      ]
                    },
                    "timezone": {
                      "type": "string",
                      "enum": [
                        "Asia/Kolkata"
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Ambiguous/forged headers, Authorization header or request body denied."
          },
          "401": {
            "description": "Missing, invalid, expired, revoked or stale session."
          },
          "403": {
            "description": "Caller certificate identity, selected tenant or school.read denied."
          },
          "404": {
            "description": "School absent/inactive/unlinked, unsupported method/path, or public listener."
          },
          "503": {
            "description": "Identity/TLS/database/contract/deadline failure or expired decision; fail closed."
          }
        }
      }
    },
    "/v1/schools/{tenantId}/teaching-assignments/{assignmentId}/review-queue": {
      "get": {
        "operationId": "getAuthenticatedTeacherReviewQueue",
        "summary": "Read pending reviews for an assigned teacher",
        "description": "Private TLS 1.3 listener; trusted exact gateway URI SAN required. Runtime has only a narrow SECURITY DEFINER function with fixed search path and FORCE RLS; no direct domain-table read grants. GET only, no HEAD alias or request body. queue is required; limit defaults to 25 (maximum 100), with optional afterId. Reject duplicate/unknown/empty query fields, percent encodings, fragments and noncanonical UUIDs/numbers. Requires a fresh identity decision for core.teacher-review-queue.read.v1 / learning.review_queue_read and a current staff binding matching BOTH user and membership in the selected tenant. Core requires active linked school, staff, assignment and academic year. Guardian bindings and school.read alone grant no access. Cursor remains valid after processing its row, but must belong to the requested original section/year and queue. Return metadata only, never lesson/submission/feedback content. One REPEATABLE READ snapshot and atomic actor audit; access already admitted may finish after revocation. No authorization cache or retry.",
        "tags": [
          "Teacher review queues"
        ],
        "servers": [
          {
            "url": "https://127.0.0.1:3442",
            "description": "Optional private mTLS listener; not publicly routed."
          }
        ],
        "security": [
          {
            "CampusSession": []
          }
        ],
        "x-mtls-required": true,
        "x-client-uri-san": "spiffe://campus/campus-api-gateway",
        "parameters": [
          {
            "name": "tenantId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            }
          },
          {
            "name": "assignmentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            }
          },
          {
            "name": "queue",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "submissions",
                "catchup"
              ]
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            },
            "description": "Canonical decimal integer; leading zeros are rejected."
          },
          {
            "name": "afterId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "No-store projected queue metadata; access audit committed. Empty queues are valid.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "tenantId",
                        "queue",
                        "teachingAssignmentId",
                        "teachingAssignmentVersion",
                        "staffId",
                        "academicYearId",
                        "sectionId",
                        "asOf",
                        "items",
                        "hasMore",
                        "nextAfterId"
                      ],
                      "properties": {
                        "tenantId": {
                          "type": "string",
                          "format": "uuid",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                        },
                        "queue": {
                          "type": "string",
                          "enum": [
                            "submissions"
                          ]
                        },
                        "teachingAssignmentId": {
                          "type": "string",
                          "format": "uuid",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                        },
                        "teachingAssignmentVersion": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 2147483647
                        },
                        "staffId": {
                          "type": "string",
                          "format": "uuid",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                        },
                        "academicYearId": {
                          "type": "string",
                          "format": "uuid",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                        },
                        "sectionId": {
                          "type": "string",
                          "format": "uuid",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                        },
                        "asOf": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "items": {
                          "type": "array",
                          "maxItems": 100,
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "id",
                              "version",
                              "enrolmentId",
                              "currentAttempt",
                              "homeworkId",
                              "homeworkVersion",
                              "submittedHomeworkVersion",
                              "dueDate",
                              "receivedOn",
                              "late",
                              "evidenceKind",
                              "homeworkVersionChanged"
                            ],
                            "properties": {
                              "id": {
                                "type": "string",
                                "format": "uuid",
                                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                              },
                              "version": {
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 2147483647
                              },
                              "enrolmentId": {
                                "type": "string",
                                "format": "uuid",
                                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                              },
                              "currentAttempt": {
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 2147483647
                              },
                              "homeworkId": {
                                "type": "string",
                                "format": "uuid",
                                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                              },
                              "homeworkVersion": {
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 2147483647
                              },
                              "submittedHomeworkVersion": {
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 2147483647
                              },
                              "dueDate": {
                                "type": "string",
                                "format": "date"
                              },
                              "receivedOn": {
                                "type": "string",
                                "format": "date"
                              },
                              "late": {
                                "type": "boolean"
                              },
                              "evidenceKind": {
                                "type": "string",
                                "enum": [
                                  "written_response",
                                  "offline_work"
                                ]
                              },
                              "homeworkVersionChanged": {
                                "type": "boolean"
                              }
                            }
                          }
                        },
                        "hasMore": {
                          "type": "boolean"
                        },
                        "nextAfterId": {
                          "type": "string",
                          "format": "uuid",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                          "nullable": true,
                          "description": "Last item ID only when hasMore=true; otherwise null. Cursor must belong to this queue and original assignment scope."
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "tenantId",
                        "queue",
                        "teachingAssignmentId",
                        "teachingAssignmentVersion",
                        "staffId",
                        "academicYearId",
                        "sectionId",
                        "asOf",
                        "items",
                        "hasMore",
                        "nextAfterId"
                      ],
                      "properties": {
                        "tenantId": {
                          "type": "string",
                          "format": "uuid",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                        },
                        "queue": {
                          "type": "string",
                          "enum": [
                            "catchup"
                          ]
                        },
                        "teachingAssignmentId": {
                          "type": "string",
                          "format": "uuid",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                        },
                        "teachingAssignmentVersion": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 2147483647
                        },
                        "staffId": {
                          "type": "string",
                          "format": "uuid",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                        },
                        "academicYearId": {
                          "type": "string",
                          "format": "uuid",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                        },
                        "sectionId": {
                          "type": "string",
                          "format": "uuid",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                        },
                        "asOf": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "items": {
                          "type": "array",
                          "maxItems": 100,
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "id",
                              "version",
                              "enrolmentId",
                              "currentRevision",
                              "attendanceId",
                              "pinnedAttendanceVersion",
                              "attendanceVersion",
                              "attendanceStatus",
                              "attendanceDate",
                              "attendanceVersionChanged"
                            ],
                            "properties": {
                              "id": {
                                "type": "string",
                                "format": "uuid",
                                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                              },
                              "version": {
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 2147483647
                              },
                              "enrolmentId": {
                                "type": "string",
                                "format": "uuid",
                                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                              },
                              "currentRevision": {
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 2147483647
                              },
                              "attendanceId": {
                                "type": "string",
                                "format": "uuid",
                                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                              },
                              "pinnedAttendanceVersion": {
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 2147483647
                              },
                              "attendanceVersion": {
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 2147483647
                              },
                              "attendanceStatus": {
                                "type": "string",
                                "enum": [
                                  "present",
                                  "absent",
                                  "late",
                                  "excused"
                                ]
                              },
                              "attendanceDate": {
                                "type": "string",
                                "format": "date"
                              },
                              "attendanceVersionChanged": {
                                "type": "boolean"
                              }
                            }
                          }
                        },
                        "hasMore": {
                          "type": "boolean"
                        },
                        "nextAfterId": {
                          "type": "string",
                          "format": "uuid",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                          "nullable": true,
                          "description": "Last item ID only when hasMore=true; otherwise null. Cursor must belong to this queue and original assignment scope."
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid query, body, encodings or ambiguous/forged credentials."
          },
          "401": {
            "description": "Missing, invalid, expired, revoked or stale session."
          },
          "403": {
            "description": "Selected tenant or dedicated teacher action denied (or wrong service certificate on private core)."
          },
          "404": {
            "description": "No current staff binding/assignment scope; inactive school/staff/year/assignment or unknown/out-of-scope cursor. Public core listener also returns 404."
          },
          "503": {
            "description": "Identity/TLS/database/contract/deadline failure or expired decision; fail closed."
          }
        }
      }
    }
  },
  "x-source-repository": "https://github.com/nishantgautamIT/campus-core-api",
