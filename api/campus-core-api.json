{
  "openapi": "3.0.3",
  "info": {
    "title": "campus-core-api",
    "version": "0.1.0",
    "description": "Implemented HTTP surface: health only. School provisioning, academic setup/lifecycle, students/imports, guardian/staff relationships, attendance and lessons/homework are restricted operator CLI workflows. Homework submission evidence, versioned teacher reviews and absence catch-up packs are also operator commands; they add no HTTP endpoints. Identity integration (F02) remains deferred. HEAD mirrors GET. Optional private mTLS listener exposes one identity-authorized school-profile read. The public listener still serves health only; domain operator commands are not HTTP routes."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:3000",
      "description": "Default local listener; configurable. Not a deployed production URL."
    }
  ],
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "live",
        "summary": "Liveness",
        "tags": [
          "Health"
        ],
        "description": "Unauthenticated local service health check.",
        "responses": {
          "200": {
            "description": "Healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    }
                  },
                  "required": [
                    "status"
                  ]
                }
              }
            }
          }
        },
        "security": []
      },
      "head": {
        "operationId": "liveHead",
        "summary": "Liveness (headers only)",
        "tags": [
          "Health"
        ],
        "description": "Unauthenticated local service health check. HEAD uses GET handling and returns no body.",
        "responses": {
          "200": {
            "description": "Healthy"
          }
        },
        "security": []
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "ready",
        "summary": "Database/schema readiness",
        "tags": [
          "Health"
        ],
        "description": "Unauthenticated local service health check.",
        "responses": {
          "200": {
            "description": "Healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    },
                    "database": {
                      "type": "string",
                      "enum": [
                        "available"
                      ]
                    }
                  },
                  "required": [
                    "status",
                    "database"
                  ]
                }
              }
            }
          },
          "503": {
            "description": "Unavailable or busy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "statusCode": {
                      "type": "integer"
                    },
                    "message": {
                      "type": "string"
                    },
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "statusCode",
                    "message"
                  ]
                }
              }
            }
          }
        },
        "security": []
      },
      "head": {
        "operationId": "readyHead",
        "summary": "Database/schema readiness (headers only)",
        "tags": [
          "Health"
        ],
        "description": "Unauthenticated local service health check. HEAD uses GET handling and returns no body.",
        "responses": {
          "200": {
            "description": "Healthy"
          },
          "503": {
            "description": "Unavailable or busy"
          }
        },
        "security": []
      }
    },
    "/v1/schools/{tenantId}": {
      "get": {
        "operationId": "getAuthenticatedSchoolProfile",
        "summary": "Read the selected active school profile",
        "description": "Private TLS 1.3 listener only; caller certificate must contain exact URI SAN spiffe://campus/campus-api-gateway. Forward exactly one __Host-campus_session cookie. Online identity requires matching selected tenant and school.read; core then checks active/linked school and applies transaction-local tenant RLS. No names of individuals or learning content. Successful access audit commits before response. Every request is rechecked; no cached authorization or fallback. Already admitted work may finish after identity revocation. No teacher/guardian relationship access or mutation is granted. No HEAD alias. Gateway routing is not enabled by this change.",
        "tags": [
          "Schools"
        ],
        "servers": [
          {
            "url": "https://127.0.0.1:3442",
            "description": "Optional private mTLS listener; not publicly routed."
          }
        ],
        "security": [
          {
            "CampusSession": []
          }
        ],
        "x-mtls-required": true,
        "x-client-uri-san": "spiffe://campus/campus-api-gateway",
        "parameters": [
          {
            "name": "tenantId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "No-store school profile; audited access.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "code",
                    "name",
                    "status",
                    "timezone"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "code": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "active"
                      ]
                    },
                    "timezone": {
                      "type": "string",
                      "enum": [
                        "Asia/Kolkata"
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Ambiguous/forged headers, Authorization header or request body denied."
          },
          "401": {
            "description": "Missing, invalid, expired, revoked or stale session."
          },
          "403": {
            "description": "Caller certificate identity, selected tenant or school.read denied."
          },
          "404": {
            "description": "School absent/inactive/unlinked, unsupported method/path, or public listener."
          },
          "503": {
            "description": "Identity/TLS/database/contract/deadline failure or expired decision; fail closed."
          }
        }
      }
    }
  },
  "x-source-repository": "https://github.com/nishantgautamIT/campus-core-api",
  "x-source-revision": "6446854d7c3624820689e496525b62b0b004e09d",
  "x-source-status": "F02 private identity/core integration implemented on feat/identity-core-trust; gateway routing and production deployment remain outstanding",
  "components": {
    "securitySchemes": {
      "CampusSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-campus_session",
        "description": "Opaque identity browser session forwarded by the authenticated gateway. Mandatory mTLS gateway transport is separately expressed by x-mtls-required (OpenAPI 3.0 limitation)."
      }
    }
  }
}
