{
  "openapi": "3.0.3",
  "info": {
    "title": "campus-api-gateway",
    "version": "0.1.0",
    "description": "Public gateway: health, published school pages and optional admission enquiries. Identity, student and internal receiver paths are not routed. Routes require exact paths without query strings or trailing slashes. Generic limits apply to all requests; one process with in-memory counters is currently supported. Enquiries are implemented in PR #2, merged 3 November 2026. Optional authenticated core school-profile routing uses the common limiter and a private mTLS upstream; login/auth routes are still closed."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8080",
      "description": "Default local listener; configurable. Not a deployed production URL."
    }
  ],
