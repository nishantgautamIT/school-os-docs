    "/schools/{slug}/enquiries": {
      "post": {
        "operationId": "submitEnquiry",
        "summary": "Submit an admission enquiry",
        "tags": [
          "Admissions"
        ],
        "description": "Feature PR #2, merged 3 November 2026. Anonymous public submission with adult declaration and contact consent. Origin must exactly equal PUBLIC_ORIGIN; browser supplies it. Exact application/json; no Content-Encoding or Expect; max 8 KiB and three-second body deadline. Idempotency UUID is lowercased by gateway. Additional submission limits apply. Returns 503 if enquiry routing is not configured. No enquiry reading/listing endpoint is public.",
        "responses": {
          "202": {
            "description": "Accepted, including an exact normalized retry",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "accepted": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "requestId": {
                      "type": "string",
                      "format": "uuid"
                    }
                  },
                  "required": [
                    "accepted",
                    "requestId"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "403": {
            "description": "Origin, CSRF, or permission denied",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Resource not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "405": {
            "description": "Method not allowed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "408": {
            "description": "Body read deadline exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
