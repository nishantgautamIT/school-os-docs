    "/api/schools/{tenantId}": {
      "get": {
        "operationId": "readAuthenticatedCoreSchool",
        "summary": "Read the selected school through the common gateway",
        "tags": [
          "Authenticated core"
        ],
        "description": "Optional route requiring complete CORE_API_ORIGIN and CORE_TLS_*_FILE configuration. GET only; no HEAD alias. The common socket-network, school-selector and global budgets run before backend calls. Forward exactly one __Host-campus_session cookie over private TLS 1.3 to core /v1/schools/{tenantId}; verify core CA, hostname and exact service URI. No direct identity call or authorization cache at the gateway: core checks current identity and school permissions. Strip browser identity/forwarding headers and unrelated cookies. Reject body, query, bearer credential or ambiguous cookies. Canned denials prevent leaking upstream diagnostics. External browser-facing HTTPS and private network deployment remain operational requirements. Login routes and teacher/guardian workflows are not enabled here.",
        "security": [
          {
            "CampusSession": []
          }
        ],
        "parameters": [
          {
            "name": "tenantId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "No-store active school profile; exact response fields only.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "code",
                    "name",
                    "status",
                    "timezone"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "code": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9-]{2,39}$"
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "active"
                      ]
                    },
                    "timezone": {
                      "type": "string",
                      "enum": [
                        "Asia/Kolkata"
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bodies, encodings, duplicate headers or bearer credentials rejected."
          },
          "401": {
            "description": "Missing/ambiguous/invalid/expired/revoked session."
          },
