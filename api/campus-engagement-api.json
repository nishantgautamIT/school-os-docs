    "/internal/core-events": {
      "post": {
        "operationId": "receiveCoreEvent",
        "summary": "Receive a school provisioning event",
        "tags": [
          "Internal events"
        ],
        "description": "Private receiver on port 3003. Exact Content-Type application/json; no Content-Encoding; max 16 KiB. Canonical signature input: \"campus-core-events-v1\\n\" + timestamp + \"\\nPOST\\n/internal/core-events\\n\" + exact body bytes. Event and tenant UUIDs must be lowercase; schoolName must be trimmed and control-free. Retry same event ID/payload is idempotent; conflict returns 409.",
        "responses": {
          "200": {
            "description": "Accepted/replayed event",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "eventId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "tenantId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "accepted": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    }
                  },
                  "required": [
                    "eventId",
                    "tenantId",
                    "accepted"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid authentication",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Resource not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "409": {
            "description": "Idempotency key reused with different normalized content",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "413": {
            "description": "Request exceeds body limit",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "415": {
            "description": "Unsupported content type or encoding",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "503": {
            "description": "Unavailable or busy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        },
        "security": [
          {
            "EventKeyId": [],
            "EventTimestamp": [],
            "EventSignature": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "school.profile_provisioned.v1"
                    ]
                  },
                  "payload": {
                    "type": "object",
                    "properties": {
                      "schemaVersion": {
                        "type": "integer",
                        "enum": [
                          1
                        ]
                      },
                      "eventId": {
                        "type": "string",
                        "format": "uuid"
                      },
                      "tenantId": {
                        "type": "string",
                        "format": "uuid"
                      },
                      "schoolCode": {
                        "type": "string",
                        "pattern": "^[a-z0-9][a-z0-9-]{2,39}$"
                      },
                      "schoolName": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      },
                      "identityLinkState": {
                        "type": "string",
                        "enum": [
                          "pending"
                        ]
                      }
                    },
                    "required": [
                      "schemaVersion",
                      "eventId",
                      "tenantId",
                      "schoolCode",
                      "schoolName",
                      "identityLinkState"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "type",
                  "payload"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "servers": [
          {
            "url": "http://127.0.0.1:3003",
            "description": "Private event listener; not the public site server."
          }
        ]
      }
    },
    "/internal/enquiries/{slug}": {
      "post": {
        "operationId": "receiveEnquiry",
        "summary": "Persist an admission enquiry from the gateway",
        "tags": [
          "Internal enquiries"
        ],
        "description": "Feature PR #3, merged 3 November 2026. Private listener on port 3004. Max 8 KiB, three-second body deadline. Exact application/json; no Content-Encoding or Expect. Canonical HMAC input: \"campus-enquiries-v1\\n\" + timestamp + \"\\nPOST\\n/internal/enquiries/\" + slug + \"\\n\" + lowercase idempotency UUID + \"\\n\" + exact body bytes. Dedicated enquiry keys are separate from event keys. Requires a published contact page for new submissions; exact recorded retries remain accepted.",
        "responses": {
          "202": {
            "description": "Accepted, including an exact normalized retry",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "accepted": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "requestId": {
                      "type": "string",
                      "format": "uuid"
                    }
                  },
                  "required": [
                    "accepted",
                    "requestId"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid authentication",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Resource not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "408": {
            "description": "Body read deadline exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "409": {
            "description": "Idempotency key reused with different normalized content",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "413": {
            "description": "Request exceeds body limit",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "415": {
            "description": "Unsupported content type or encoding",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "417": {
            "description": "Expect header unsupported",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "503": {
            "description": "Unavailable or busy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        },
        "security": [
          {
            "EnquiryKeyId": [],
            "EnquiryTimestamp": [],
            "EnquirySignature": []
          }
        ],
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{2,39}$"
            },
            "description": "Published school slug; 3\u201340 lowercase letters/digits/hyphens."
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Stable UUID for one submission; same normalized payload returns the same receipt, different payload returns 409. Private receiver expects lowercase."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "contactName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "phone": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 32,
                    "description": "Indian mobile: 10 digits starting 6\u20139 or +91 prefix; spaces, parentheses and hyphens stripped."
                  },
                  "email": {
                    "type": "string",
                    "maxLength": 254,
                    "description": "Optional; empty accepted, otherwise a valid email address, normalized lowercase."
                  },
                  "interest": {
                    "type": "string",
                    "maxLength": 80
                  },
                  "message": {
                    "type": "string",
                    "maxLength": 1000,
                    "description": "Optional text, trimmed with CRLF normalized to LF. Tabs and line breaks accepted; other control characters rejected. Text is stored privately, not rendered as HTML."
                  },
                  "contactConsent": {
                    "type": "boolean",
                    "enum": [
                      true
                    ]
                  },
                  "isAdult": {
                    "type": "boolean",
                    "enum": [
                      true
                    ]
                  }
                },
                "required": [
                  "contactName",
                  "phone",
                  "contactConsent",
                  "isAdult"
                ],
                "additionalProperties": false,
                "example": {
                  "contactName": "Demo Parent",
                  "phone": "+919876543210",
                  "interest": "Class 4",
                  "message": "Please share admission information.",
                  "contactConsent": true,
                  "isAdult": true
                }
              }
            }
          }
        },
        "servers": [
          {
            "url": "http://127.0.0.1:3004",
            "description": "Private enquiry listener."
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "EventKeyId": {
        "type": "apiKey",
        "in": "header",
        "name": "X-campus-key-id",
        "description": "Configured verification key identifier (1\u201340 letters/digits/_/-)."
      },
      "EventTimestamp": {
        "type": "apiKey",
        "in": "header",
        "name": "X-campus-timestamp",
        "description": "Ten-digit Unix timestamp in seconds, within 300 seconds of receiver time."
      },
      "EventSignature": {
        "type": "apiKey",
        "in": "header",
        "name": "X-campus-signature",
        "description": "Lowercase hex HMAC-SHA256 over canonical metadata and the exact raw request bytes. This is a computed signature, not a reusable access token."
      },
      "EnquiryKeyId": {
        "type": "apiKey",
        "in": "header",
        "name": "X-enquiry-key-id",
        "description": "Configured verification key identifier (1\u201340 letters/digits/_/-)."
      },
      "EnquiryTimestamp": {
        "type": "apiKey",
        "in": "header",
        "name": "X-enquiry-timestamp",
        "description": "Ten-digit Unix timestamp in seconds, within 300 seconds of receiver time."
      },
      "EnquirySignature": {
        "type": "apiKey",
        "in": "header",
        "name": "X-enquiry-signature",
        "description": "Lowercase hex HMAC-SHA256 over canonical metadata and the exact raw request bytes. This is a computed signature, not a reusable access token."
      }
    }
  },
  "x-source-repository": "https://github.com/nishantgautamIT/campus-engagement-api",
  "x-source-revision": "70a576168390eb3e735e21736245811f9e9285ff",
  "x-source-status": "implemented; enquiries merged 3 November 2026"
}
