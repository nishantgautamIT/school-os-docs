{
  "openapi": "3.0.3",
  "info": {
    "title": "campus-engagement-api",
    "version": "0.1.0",
    "description": "Public school HTML plus separate private HTTP listeners. Public site pages contain published content only. Internal receivers are service-to-service HMAC endpoints on different ports; never expose them through the public gateway. Website editing, publication and enquiry inbox administration remain operator commands. Admission enquiries are implemented on a feature branch (PR #3), merged 3 November 2026."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:3002",
      "description": "Default local listener; configurable. Not a deployed production URL."
    }
  ],
